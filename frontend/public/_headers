# Netlify edge/browser cache rules for the Vite SPA build.
#
# Addresses the net::ERR_HTTP2_PROTOCOL_ERROR seen on /assets/vendor-*.js:
# without explicit rules, large hashed vendor chunks were not declared
# immutable, so the CDN/browser could re-validate or partially re-fetch them
# more than necessary — the most common cause of this error on Netlify. Every
# file Vite outputs under /assets/ is content-hashed (the filename changes
# whenever the content does), so it is safe to cache forever; index.html must
# NEVER be cached long-term, or browsers keep loading an old deploy's HTML
# that points at asset hashes the CDN no longer serves.

# Hashed, content-addressed build output — cache forever, never revalidate.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The SPA shell must always be revalidated so it picks up the latest asset
# hashes after every deploy.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Service worker script: browsers already cap SW caching at ~24h, but say so
# explicitly so a new deploy's push-notification logic takes effect promptly.
/firebase-messaging-sw.js
  Cache-Control: public, max-age=0, must-revalidate
